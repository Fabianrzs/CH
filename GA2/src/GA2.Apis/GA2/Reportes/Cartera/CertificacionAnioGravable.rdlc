							<Paragraphs>
								<Paragraph>
									<TextRuns>
										<TextRun>
											<Value>"De acuerdo con el articulo 10 del decreto Reglamentario No. 836 de 1991, las certificaciones expedidas en forma continua impresa por computador no requieren firma autografiada"</Value>
											<Style>
