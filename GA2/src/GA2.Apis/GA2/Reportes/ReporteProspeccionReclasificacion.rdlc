  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Rectangle Name="Rectangle2">
            <ReportItems>
              <Textbox Name="Textbox15">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Certificado de reclasificación de Cliente por capacidad de pago</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value />
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>A los </Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Parameters!Dia.Value</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value> días del mes </Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Parameters!Mes.Value</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value> de </Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Parameters!Anio.Value</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>, el Asesor de Servicio de Caja Honor, </Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Parameters!Asesor.Value</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>, expide esta certificación, con base en los paz y salvos presentados por el Cliente </Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Parameters!Nombres.Value</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>,  modificando el estado de obligaciones reportado por TransUnión, de la siguiente manera:</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>Textbox15</rd:DefaultName>
                <Top>0.20323in</Top>
                <Left>0.26025in</Left>
                <Height>1.13725in</Height>
                <Width>6.71131in</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
            </ReportItems>
            <KeepTogether>true</KeepTogether>
            <Top>0.12252in</Top>
            <Left>0.37219in</Left>
            <Height>1.43171in</Height>
            <Width>7.24493in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>
          <Rectangle Name="Rectangle5">
            <ReportItems>
              <Textbox Name="Textbox3">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>En constancia de lo anterior se expide esta certificación y se adjunta a la hoja de vida electrónica del afiliado copia de los paz y salvos presentados .</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value />
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Cordialmente, </Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Parameters!Asesor.Value</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Asesor de Servicio</Value>
                        <Style>
                          <FontSize>11pt</FontSize>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>Textbox3</rd:DefaultName>
