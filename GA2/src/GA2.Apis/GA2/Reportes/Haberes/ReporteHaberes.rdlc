          <Textbox Name="Textbox74">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Atendiendo su solicitud realizada, en la cual se requiere información consolidada de haberes, del período comprendido entre el </Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Label>FechaPrimerAporte</Label>
                    <Value>=Parameters!fechaPrimerAporte.Value</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> y el </Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!fechaReporte.Value</Value>
                    <Style>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> le informo:</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox74</rd:DefaultName>
            <Top>3.65594cm</Top>
            <Left>0.46911in</Left>
            <Height>1.21384cm</Height>
