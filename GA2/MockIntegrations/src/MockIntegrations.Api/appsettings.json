{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "MockIntegrations": {
    "FixturesOverridePath": null,
    "SlowScenarioDelayMs": 20000,
    "LatencyMs": {},
    "Journal": {
      "Enabled": true,
      "Capacity": 500,
      "MaxBodyChars": 65536
    },
    "Smtp": {
      "Enabled": true,
      "Port": 2525,
      "RejectRecipients": [ "rechazado@mock.test" ],
      "Capacity": 200
    },
    "ServiceBus": {
      "ConnectionString": null,
      "Topic": "chonorintegraciones"
    },
    "TusDatos": {
      "ApiKey": "clave-de-prueba",
      "PollsUntilFinished": 1,
      "PendingStatus": "pendiente",
      "FinishedStatus": "finalizado"
    },
    "KtrionApi": {
      "RequireIssuedToken": true
    },
    "TransUnion": {
      "ValidPin": "123456",
      "FirstApplicationId": 9876543
    },
    "Scenarios": {
      "Defaults": {},
      "Rules": [
        { "Provider": "Bua", "Operation": "ObtenerBUA", "Field": "identificacion", "EqualsValue": "1000000404", "Scenario": "no-encontrado", "Description": "Afiliado inexistente (GA2 reintenta tipo_Id 1 → 4 → 5)" },
        { "Provider": "Bua", "Operation": "ObtenerBUA", "Field": "identificacion", "EqualsValue": "1000000004", "Scenario": "encontrado-tipo-4", "Description": "Sólo se encuentra con tipo_Id 4" },
        { "Provider": "Bua", "Operation": "ObtenerBUA", "Field": "identificacion", "EqualsValue": "1000000500", "Scenario": "fault", "Description": "Falla técnica del servicio BUA" },
        { "Provider": "Vigia", "Operation": "F_VERIFICATERCERO", "Field": "param1", "EqualsValue": "1000000666", "Scenario": "reportado", "Description": "Persona reportada en listas" },
        { "Provider": "Vigia", "Operation": "F_VERIFICATERCERO", "Field": "param1", "EqualsValue": "1000000500", "Scenario": "fault", "Description": "Falla técnica de Vigía" },
        { "Provider": "Fenix", "Operation": "ValidarBiometria", "Field": "identificacion", "EqualsValue": "1000000404", "Scenario": "sin-datos", "Description": "Sin datos biométricos" },
        { "Provider": "Fenix", "Operation": "ValidarBiometria", "Field": "identificacion", "EqualsValue": "1000000002", "Scenario": "parcial", "Description": "Biometría incompleta" },
        { "Provider": "Fenix", "Operation": "ValidarBiometria", "Field": "identificacion", "EqualsValue": "1000000500", "Scenario": "fault", "Description": "Falla técnica de Fénix" },
        { "Provider": "Haberes", "Operation": "GenerarReporte", "Field": "customerIdentification", "EqualsValue": "1000000404", "Scenario": "sin-reporte", "Description": "Sin reporte" },
        { "Provider": "Haberes", "Operation": "GenerarReporteV2", "Field": "customerIdentification", "EqualsValue": "1000000404", "Scenario": "sin-reporte", "Description": "Sin reporte" },
        { "Provider": "Haberes", "Operation": "ReporteHaberes", "Field": "customerIdentification", "EqualsValue": "1000000404", "Scenario": "vacio", "Description": "DataSet vacío" },
        { "Provider": "TransUnion", "Operation": "ExecuteXMLString", "Field": "IdNumber", "EqualsValue": "1000000666", "Scenario": "no-viable", "Description": "Cliente NO VIABLE en AQM/prospección" },
        { "Provider": "TransUnion", "Operation": "ExecuteXMLString", "Field": "IdNumber", "EqualsValue": "1000000777", "Scenario": "pendiente", "Description": "Decisión PENDIENTE" },
        { "Provider": "TransUnion", "Operation": "ExecuteXMLString", "Field": "IdNumber", "EqualsValue": "1000000999", "Scenario": "muerte-titular", "Description": "Documento con estado MUERTE POR TITULAR" },
        { "Provider": "TransUnion", "Operation": "ExecuteXMLString", "Field": "IdNumber", "EqualsValue": "1000000500", "Scenario": "fault", "Description": "Falla técnica de TransUnion" },
        { "Provider": "TusDatos", "Operation": "*", "Field": "identification", "EqualsValue": "1000000404", "Scenario": "no-encontrado", "Description": "404: GA2 devuelve éxito con Data=null" },
        { "Provider": "TusDatos", "Operation": "ConsultarCliente", "Field": "identification", "EqualsValue": "1000000666", "Scenario": "pep", "Description": "Persona expuesta políticamente" },
        { "Provider": "TusDatos", "Operation": "ConsultarVigia", "Field": "identification", "EqualsValue": "1000000666", "Scenario": "riesgo", "Description": "Riesgo LA/FT alto" },
        { "Provider": "TusDatos", "Operation": "ConsultarCliente", "Field": "identification", "EqualsValue": "1000000100", "Scenario": "historial", "Description": "Resultado tomado del histórico" },
        { "Provider": "WorkManager", "Operation": "Form_Insert", "Field": "FormCode", "EqualsValue": "999", "Scenario": "fallido", "Description": "Radicación con Success=false" }
      ]
    }
  }
}
