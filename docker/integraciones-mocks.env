# Integraciones de GA2/BUA apuntando a MockIntegrations dentro de la red de contenedores.
# Equivale a GA2/MockIntegrations/ga2-config/ga2-mocks.env.sh con MOCK_BASE_URL=http://mockintegrations:5080.
# Credenciales ficticias: las reales nunca viajan al mock.
AppMain__ApplicationName=IntegracionesKriterion
AppMain__Password=mock-password
AppMain__ApplicationId=mock-application-id
CHKeys__UrlCajaHonor=http://mockintegrations:5080/REST/KriterionDev/ktrionApi/
CHKeys__User=mock-user
CHKeys__Token=mock-token
IdVision__usuarioIDVision=mock-usuario-idvision
IdVision__claveIDVision=mock-clave-idvision
Aqm__usuarioAqm=mock-usuario-aqm
Aqm__claveAqm=mock-clave-aqm
SvcUtils__BuaUrlSvc=http://mockintegrations:5080/Kriterion.ws.01/BaseUnicaAfiliados/BUA_API.svc
SvcUtils__BuaUrlServiceApi=http://mockintegrations:5080/Kriterion.ws.02/BaseUnicaAfiliados/BUA_API.svc
SvcUtils__WorkManagerUrlSvc=http://mockintegrations:5080/APIV2_0005/WorkManagerService.svc
SvcUtils__HaberesUrlSvc=http://mockintegrations:5080/MCDIntegrationServices/wsModeloCanonico.asmx
SvcUtils__VigiaVerificarTerceroUrlSvc=http://mockintegrations:5080/WebSvc/SOAP_VerificaTercero.php
SvcUtils__FenixServiceSvc=http://mockintegrations:5080/WsFenixBiometria/WebServicesBiometrias.asmx?WSDL
SvcUtils__SevenWSFactura=http://mockintegrations:5080/Seven/Wsfactura/spofactu.asmx
SvcUtils__SevenWSCdp=http://mockintegrations:5080/Seven/WsCdp/WPgOblig.asmx
SvcUtils__SevenWintipro=http://mockintegrations:5080/Seven/Wintipro/WInTipro.asmx
SvcUtils__SevenWSMovContable=http://mockintegrations:5080/Seven/WsMovContable/scnmcont.asmx
SvcUtils__SevenWSProveedor=http://mockintegrations:5080/Seven/Wsproveedor/SIeWssec.asmx
SvcUtils__SevenWSTercero=http://mockintegrations:5080/Seven/Wstercero/wgnterce.asmx
SvcUtils__SevenWSAportes=http://mockintegrations:5080/Seven/WSaportes/ValidarAportes.asmx
Integrationes__TusDatos__BaseUrl=http://mockintegrations:5080/kiosko-dev/
Integrationes__TusDatos__ApiKey=clave-de-prueba
Integrationes__Dodo__BaseUrl=http://mockintegrations:5080/dodo/
SMTP__Host=mockintegrations
SMTP__Puerto=2525
SMTP__HabilitarSsl=false
SMTP__Usuario=notificaciones@cajahonor.gov.co
SMTP__Clave=
# Emulador de Service Bus detrás del proxy TLS (clave pública y documentada del emulador).
EventBusConnection=Endpoint=sb://servicebus-tls;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;EntityPath=chonorintegraciones
EventBusPassword=SAS_KEY_VALUE
